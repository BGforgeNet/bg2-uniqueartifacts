PRINT ~Processing creatures~

// Creatures whose copy of an artifact makes them work: they keep their items, and that copy is made unstealable and
// undroppable instead.
ACTION_DEFINE_ASSOCIATIVE_ARRAY locked_items BEGIN
    ~botsmith.cre~ => ~clck24~  // Cespenar: Cloak of Reflection makes him invulnerable
END

COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    SPRINT res ~%SOURCE_FILE%~
    TO_LOWER res
    PATCH_IF VARIABLE_IS_SET $custom_regex(~%res%~) BEGIN
        SPRINT regex $custom_regex(~%res%~)
    END ELSE BEGIN
        SPRINT regex ~%common_regex%~
    END
    PATCH_PHP_EACH replacement AS old_item => new_item  BEGIN
        PATCH_IF NOT (VARIABLE_IS_SET $item_source(~%old_item%~ ~%res%~) AND $item_source(~%old_item%~ ~%res%~) == 1) BEGIN
            PATCH_IF ~%res%~ STR_EQ ~BDANGATH.cre~ BEGIN
                PATCH_PRINT ~bdanganth: res=%res%, old_item=%old_item%, new_item=%new_item%~
                PATCH_PRINT ~bdanganth: regex=%regex%~
            END
            LPF REPLACE_CRE_ITEM_MATCH
                STR_VAR
                    match_item = ~%old_item%~
                    new_item
            END
        END
    END
    PATCH_IF VARIABLE_IS_SET $locked_items(~%res%~) BEGIN
        SPRINT locked $locked_items(~%res%~)
        GET_OFFSET_ARRAY item_offs CRE_V10_ITEMS
        PHP_EACH item_offs AS int => ioff BEGIN
            READ_ASCII (ioff + CRE_ITEM_name) name (8) NULL
            PATCH_IF ~%name%~ STRING_MATCHES_REGEXP ~^%locked%$~ = 0 BEGIN
                WRITE_LONG (ioff + CRE_ITEM_flags) (THIS | FLAG_CRE_ITEM_unstealable | FLAG_CRE_ITEM_undroppable)
            END
        END
    END ELSE BEGIN
        LPF LOG_ITEMS_TO_DELETE STR_VAR item_to_delete = ~%regex%~ END
        LPF DELETE_CRE_ITEM
            STR_VAR
                item_to_delete = ~%regex%~
        END
    END
BUT_ONLY
