
// DELETE_CRE_ITEM, except for items whose flags contain all of "locked_flags". Header offsets and slot indexes are
// fixed up as WeiDU's DELETE_CRE_ITEM does, plus the effects offset, which may follow the items.
DEFINE_PATCH_FUNCTION DELETE_UNLOCKED_CRE_ITEM
  INT_VAR
    locked_flags = 0
  STR_VAR
    item_to_delete = ~~
BEGIN
  LPF FJ_CRE_VALIDITY RET valid END
  PATCH_IF valid BEGIN
    READ_LONG CRE_items_offset items_off
    READ_LONG CRE_items_count items_count
    FOR (i = 0; i < items_count; ++i) BEGIN
      item_off = items_off + i * 0x14  // item entry size
      READ_ASCII (item_off + CRE_ITEM_name) item
      READ_LONG (item_off + CRE_ITEM_flags) flags
      PATCH_IF (~%item%~ STRING_MATCHES_REGEXP ~%item_to_delete%~ = 0)
        AND (locked_flags = 0 OR (flags BAND locked_flags) != locked_flags)
      BEGIN
        DELETE_BYTES item_off 0x14
        items_count -= 1
        PATCH_FOR_EACH header IN
          ~%CRE_known_spells_offset%~ ~%CRE_memorization_info_offset%~ ~%CRE_memorized_spells_offset%~
          ~%CRE_item_slots_offset%~ ~%CRE_effects_offset%~
        BEGIN
          READ_LONG header off
          PATCH_IF off > items_off BEGIN
            WRITE_LONG header (off - 0x14)
          END
        END
        READ_LONG CRE_item_slots_offset slots_off
        FOR (s = 0; s < 37; ++s) BEGIN  // the slot count WeiDU's DELETE_CRE_ITEM fixes up
          READ_SHORT (slots_off + s * 2) index
          PATCH_IF index = i BEGIN
            WRITE_SHORT (slots_off + s * 2) 0xffff
          END ELSE PATCH_IF index > i AND index != 0xffff BEGIN
            WRITE_SHORT (slots_off + s * 2) (index - 1)
          END
        END
        i -= 1  // the next item moved into this index
      END
    END
    WRITE_LONG CRE_items_count items_count
  END
END

//Replace all actions which give the party "old_item" with a corresponding action and "new_item". "old_item" may be a regexp.
DEFINE_PATCH_FUNCTION REPLACE_D_AND_BAF_ITEM
  STR_VAR
    old_item = ~~
    new_item = ~~
BEGIN
  REPLACE_EVALUATE CASE_INSENSITIVE
    ~GiveItem("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: GiveItem %MATCH1% -> %new_item%~ END
    ~GiveItem("%new_item%"%MATCH2%)~

  REPLACE_EVALUATE CASE_INSENSITIVE
    ~GiveItemCreate("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: GiveItemCreate %MATCH1% -> %new_item%~ END
    ~GiveItemCreate("%new_item%"%MATCH2%)~

  REPLACE_EVALUATE CASE_INSENSITIVE
    ~CreateItem("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: CreateItem %MATCH1% -> %new_item%~ END
    ~CreateItem("%new_item%"%MATCH2%)~

  REPLACE_EVALUATE CASE_INSENSITIVE
    ~CreateItemGlobal("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: CreateItemGlobal %MATCH1% -> %new_item%~ END
    ~CreateItemGlobal("%new_item%"%MATCH2%)~

  REPLACE_EVALUATE CASE_INSENSITIVE
    ~CreateItemNumGlobal("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: CreateItemNumGlobal %MATCH1% -> %new_item%~ END
    ~CreateItemNumGlobal("%new_item%"%MATCH2%)~

  REPLACE_EVALUATE CASE_INSENSITIVE
    ~TakeItemReplace("\(%old_item%\)"\(.*\))~
    BEGIN PATCH_LOG ~UA: %SOURCE_FILE%: TakeItemReplace %MATCH1% -> %new_item%~ END
    ~TakeItemReplace("%new_item%"%MATCH2%)~
END

// Logs each item of the current CRE, STO or ARE that DELETE_CRE_ITEM, DELETE_STORE_ITEM or DELETE_AREA_ITEM would
// remove with this regex. Offsets, sizes and the 8-byte match mirror those WeiDU functions; areas scan the whole item
// list rather than walking containers.
DEFINE_PATCH_FUNCTION LOG_ITEMS_TO_DELETE
  STR_VAR
    item_to_delete = ~~
    verb = ~removing~
BEGIN
  READ_ASCII 0 sig (8)
  num = 0
  PATCH_IF ~%sig%~ STRING_MATCHES_REGEXP ~^CRE ~ = 0 AND BUFFER_LENGTH > 0x2c4 BEGIN
    READ_LONG 0x2bc off
    READ_LONG 0x2c0 num
    size = 0x14
  END ELSE PATCH_IF ~%sig%~ STRING_MATCHES_REGEXP ~^STOR~ = 0 AND BUFFER_LENGTH > 0x9a BEGIN
    READ_LONG 0x34 off
    READ_LONG 0x38 num
    size = (~%sig%~ STRING_EQUAL ~STORV1.1~) ? 0x58 : 0x1c
  END ELSE PATCH_IF ~%sig%~ STRING_MATCHES_REGEXP ~^AREA~ = 0 AND BUFFER_LENGTH > 0x11b BEGIN
    READ_LONG 0x78 off
    READ_SHORT 0x76 num
    size = 0x14
  END
  FOR (i = 0; i < num; ++i) BEGIN
    READ_ASCII (off + i * size) item
    PATCH_IF ~%item%~ STRING_MATCHES_REGEXP ~%item_to_delete%~ = 0 BEGIN
      READ_ASCII (off + i * size) name (8) NULL
      READ_LONG (off + i * size + 0x10) flags
      slot = 0 - 1
      PATCH_IF ~%sig%~ STRING_MATCHES_REGEXP ~^CRE ~ = 0 BEGIN
        READ_LONG 0x2b8 slots_off
        FOR (s = 0; s < 37; ++s) BEGIN
          PATCH_IF SHORT_AT (slots_off + s * 2) = i BEGIN slot = s END
        END
      END
      PATCH_LOG ~UA: %SOURCE_FILE%: %verb% %name% flags=%flags% slot=%slot%~
    END
  END
END

