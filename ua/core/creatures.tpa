PRINT ~Processing creatures~

// A copy both unstealable and undroppable never reaches the party, so it is no duplicate and is neither replaced nor
// deleted: Cespenar's Cloak of Reflection, for one, is his invulnerability.
OUTER_SET locked_flags = FLAG_CRE_ITEM_unstealable BOR FLAG_CRE_ITEM_undroppable

COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    SPRINT res ~%SOURCE_FILE%~
    TO_LOWER res
    PATCH_IF VARIABLE_IS_SET $custom_regex(~%res%~) BEGIN
        SPRINT regex $custom_regex(~%res%~)
    END ELSE BEGIN
        SPRINT regex ~%common_regex%~
    END
    GET_OFFSET_ARRAY item_offs CRE_V10_ITEMS
    PHP_EACH item_offs AS int => ioff BEGIN
        READ_ASCII (ioff + CRE_ITEM_name) old_item (8) NULL
        TO_LOWER old_item
        READ_LONG (ioff + CRE_ITEM_flags) flags
        PATCH_IF VARIABLE_IS_SET $replacement(~%old_item%~)
            AND (flags BAND locked_flags) != locked_flags
            AND NOT (VARIABLE_IS_SET $item_source(~%old_item%~ ~%res%~) AND $item_source(~%old_item%~ ~%res%~) == 1)
        BEGIN
            SPRINT new_item $replacement(~%old_item%~)
            WRITE_ASCIIE (ioff + CRE_ITEM_name) ~%new_item%~ #8
        END
    END
    LPF DELETE_UNLOCKED_CRE_ITEM
        INT_VAR
            locked_flags
        STR_VAR
            item_to_delete = ~%regex%~
    END
BUT_ONLY
